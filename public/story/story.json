  "scenes": [
    {
      "id": "forest_flight_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
      ],
      "text": "Bylo, nebylo. Byly tři dračí jezdkyně - Róza, Emma a Anna. Byly to kamarádky a každý den dohlížely na svoji část lesa, aby se zvířátka žijící v lesa moc nežraly navzájem.",
      "next": "forest_flight_02"
    },
    {
      "id": "forest_flight_02",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Holky, támhle se něco leskne! Co to je?",
      "next": "first_choice"
    },
    {
      "id": "first_choice",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind",
        "snow"
      ],
      "characters": [
        {
          "id": "emma",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Poleťme se podívat blíž, ať to můžeme prozkoumat.",
      "choices": [
        {
          "text": "Prozkoumat.",
          "next": "river_dam"
        },
        {
          "text": "Vrátit se domů na oběd.",
          "next": "village_home"
        }
      ]
    },
    {
      "id": "river_dam",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_01.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Co to je? Na bobří přehradu je to obří. To je fakt divné.",
      "next": "dam_with_beavers"
    },
    {
      "id": "dam_with_beavers",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "Obří bobři! A staví velkou přehradu, aby zadrželi vodu. To je nebezpečné pro ostatní zvířata v lese.",
      "next": "dam_with_beavers_roza"
    },
    {
      "id": "dam_with_beavers_roza",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Bobři! Co to děláte? Takhle blokujete vodu všem zvířatům dolů po řece! A můžete způsobit velkou povodeň.",
      "next": "dam_with_beavers_beaver"
    },
    {
      "id": "dam_with_beavers_beaver",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Jsme velcí bobři, tak potřebujeme velkou přehradu, abychom měli domov. Nechceme nikomu škodit, ale potřebujeme se postarat o sebe.",
      "next": "dam_with_beavers_choice"
    },
    {
      "id": "dam_with_beavers_choice",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Holky, nemůžeme to tak nechat. Kdyby se přehrada protrhla, mohlo by to způsobit velkou povodeň a zničit domovy mnoha zvířat. Musíme něco udělat.",
      "choices": [
        {
          "text": "Zkusit přesvědčit bobry, aby přehradu zmenšili.",
          "next": "dam_with_beavers_persuade"
        },
        {
          "text": "Poprat se s bobry, aby nás brali vážně.",
          "next": "dam_with_beavers_fight"
        }
      ]
    },
    {
      "id": "dam_with_beavers_persuade",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Jsou moc velcí, přeprat by je by nemuselo dopadnout dobře. Mohly bychom přitom poškodit přehradu a způsobit povodeň.",
      "next": "dam_with_beavers_persuade_01"
    },
    {
      "id": "dam_with_beavers_persuade_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Co by bychom mohly udělat, abyste zmenšili přehradu?",
      "next": "dam_with_beavers_persuade_02"
    },
    {
      "id": "dam_with_beavers_persuade_02",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Velcí bobři nemůžou žít v malé přehradě. Museli bychom se zase stát malými bobry.",
      "next": "dam_with_beavers_persuade_03"
    },
    {
      "id": "dam_with_beavers_persuade_03",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "A proč jste vlastně tak velcí? Co se stalo? Nemohli byste se vrátit do normální velikosti?",
      "next": "dam_with_beavers_persuade_04"
    },
    {
      "id": "dam_with_beavers_persuade_04",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Přišla sem čarodějnice, mávla kouzelnou hůlkou a byly z nám obří bobři. ",
      "next": "dam_with_beavers_persuade_05"
    },
    {
      "id": "dam_with_beavers_fight",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "Nevypadá to, že by nám naslouchali. Dejme jim do nosu a snad nás začnou brát vážně!",
      "next": "forest_flight_01"
    },
    {
      "id": "village_home",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/town_01.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "excited"
        }
      ],
      "speaker": "roza",
      "text": "Cítím kaši. Rychle, než nám ji ostatní sní!",
      "next": "forest_flight_01"
    }
  ]
}
