  "scenes": [
    {
      "id": "forest_flight_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [],
      "text": "Bylo, nebylo. Byly tři dračí jezdkyně - Róza, Emma a Anna. Byly to kamarádky a každý den dohlížely na svoji část lesa, aby se zvířátka žijící v lesa moc nežraly navzájem.",
      "next": "forest_flight_02",
      "music": "dragon_flight"
    },
    {
      "id": "forest_flight_02",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Holky, támhle se něco leskne! Co to je?",
      "next": "first_choice",
      "music": "dragon_flight"
    },
    {
      "id": "first_choice",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind",
        "snow"
      ],
      "characters": [
        {
          "id": "emma",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Poleťme se podívat blíž, ať to můžeme prozkoumat.",
      "choices": [
        {
          "text": "Prozkoumat.",
          "next": "river_dam"
        },
        {
          "text": "Vrátit se domů na oběd.",
          "next": "village_home"
        }
      ],
      "music": "dragon_flight"
    },
    {
      "id": "river_dam",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_01.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Co to je? Na bobří přehradu je to obří. To je fakt divné.",
      "next": "dam_with_beavers",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "Obří bobři! A staví velkou přehradu, aby zadrželi vodu. To je nebezpečné pro ostatní zvířata v lese.",
      "next": "dam_with_beavers_roza",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_roza",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Bobři! Co to děláte? Takhle blokujete vodu všem zvířatům dolů po řece! A můžete způsobit velkou povodeň.",
      "next": "dam_with_beavers_beaver",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_beaver",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Jsme velcí bobři, tak potřebujeme velkou přehradu, abychom měli domov. Nechceme nikomu škodit, ale potřebujeme se postarat o sebe.",
      "next": "dam_with_beavers_choice",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_choice",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Holky, nemůžeme to tak nechat. Kdyby se přehrada protrhla, mohlo by to způsobit velkou povodeň a zničit domovy mnoha zvířat. Musíme něco udělat.",
      "choices": [
        {
          "text": "Zkusit přesvědčit bobry, aby přehradu zmenšili.",
          "next": "dam_with_beavers_persuade"
        },
        {
          "text": "Poprat se s bobry, aby nás brali vážně.",
          "next": "dam_with_beavers_fight"
        }
      ],
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_persuade",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "Jsou moc velcí, přeprat by je by nemuselo dopadnout dobře. Mohly bychom přitom poškodit přehradu a způsobit povodeň.",
      "next": "dam_with_beavers_persuade_01",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_persuade_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "emma",
      "text": "Co by bychom mohly udělat, abyste zmenšili přehradu?",
      "next": "dam_with_beavers_persuade_02",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_persuade_02",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Velcí bobři nemůžou žít v malé přehradě. Museli bychom se zase stát malými bobry.",
      "next": "dam_with_beavers_persuade_03",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_persuade_03",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "A proč jste vlastně tak velcí? Co se stalo? Nemohli byste se vrátit do normální velikosti?",
      "next": "dam_with_beavers_persuade_04",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_persuade_04",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Přišla sem čarodějnice, mávla kouzelnou hůlkou a byly z nám obří bobři.",
      "next": "dam_with_beavers_persuade_05",
      "music": "forest_ground"
    },
    {
      "id": "dam_with_beavers_fight",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "Nevypadá to, že by nám naslouchali. Dejme jim do nosu a snad nás začnou brát vážně!",
      "next": "beaver_battle",
      "music": "forest_ground"
    },
    {
      "id": "beaver_battle",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "minigame": {
        "type": "dragonAttack",
        "title": "Dračí nálet na bobry",
        "allowSkip": true,
        "onVictory": "beaver_battle_win",
        "onFailure": "beaver_battle_lose",
        "config": {}
      },
      "music": "battle"
    },
    {
      "id": "beaver_battle_win",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "happy"
        }
      ],
      "speaker": "roza",
      "text": "Zvládly jsme to! Teď nás bobři určitě budou brát vážně a domluvíme se na menší přehradě.",
      "next": "beaver_after_battle_win_01",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Jde z vás stejně velký strach jako z té čarodějnice. Zmenšíme naši přehradu, ale musíte nám pomoct se zmenšit. Jinak se do ní nevejdeme.",
      "next": "beaver_after_battle_win_02",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_02",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "A proč jste vlastně tak velcí? Co se stalo? Nemohli byste se vrátit do normální velikosti?",
      "next": "beaver_after_battle_win_03",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_03",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Přišla sem čarodějnice, mávla kouzelnou hůlkou a byly z nám obří bobři.",
      "next": "beaver_after_battle_win_04",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_04",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "roza",
      "text": "A proč to udělala? Jaký pro to mohla mít důvod?",
      "next": "beaver_after_battle_win_05",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_05",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Co já vím. Ale když ji najdete, tak by nás mohla zase zmenšit.",
      "next": "beaver_after_battle_win_06",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_06",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "anna",
      "text": "A jak ji poznáme? Kam šla?",
      "next": "beaver_after_battle_win_07",
      "music": "forest_ground"
    },
    {
      "id": "beaver_after_battle_win_07",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "speaker": "Velký bobr",
      "text": "Měla zrzavé vlasy, hodně bledou pleť a hodně pih. Taky byla hodně vysoká a vysportovaná, ale měla šarlatové šaty šlechtičny. Kam se poděla těžko říct, ale je nepřehlédnutelná, můžete se zkusit poptat.",
      "next": "beaver_after_battle_win_07",
      "music": "forest_ground"
    },
    {
      "id": "beaver_battle_lose",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/dam_02.png"
      },
      "effects": [],
      "characters": [
        {
          "id": "anna",
          "position": "center",
          "pose": "sad"
        }
      ],
      "speaker": "anna",
      "text": "To se nepovedlo, bobři jsou prostě moc velcí. Musíme to zkusit znovu, nebo vymyslet jiný plán.",
      "choices": [
        {
          "text": "Zkusit nálet znovu.",
          "next": "beaver_battle"
        },
        {
          "text": "Raději bobry přesvědčit.",
          "next": "dam_with_beavers_persuade"
        }
      ],
      "music": "forest_ground"
    },
    {
      "id": "village_home",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/town_01.png"
      },
      "effects": [
        "wind"
      ],
      "characters": [
        {
          "id": "roza",
          "position": "center",
          "pose": "excited"
        }
      ],
      "speaker": "roza",
      "text": "Cítím kaši. Rychle, než nám ji ostatní sní!",
      "next": "lunch_in_town",
      "music": "village_day"
    },
    {
      "id": "lunch_in_town",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/lunch_in_town.png"
      },
      "effects": [
        "wind"
      ],
      "text": "Holky se s chutí vrhly na kaši, po dlouhém letu jim fakt vyhládlo.",
      "next": "flooded_town",
      "music": "village_day"
    },
    {
      "id": "flooded_town",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/town_flooded.png"
      },
      "effects": [
        "wind"
      ],
      "text": "Zatímco dračí jezdkyně jedly kaši, na město se přiřítila povodeň a zaplavila ho.",
      "end": {
        "good": false,
        "title": "Zaplavené město",
        "text": "Jezdkyně se nešly podívat, co se v lese leskne. Obří bobří přehrada se protrhla a voda zaplavila město. Příště to zkus prozkoumat!"
      },
      "music": "village_day"
    }
  ]
}
