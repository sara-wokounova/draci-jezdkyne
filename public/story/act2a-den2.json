{
  "scenes": [
    {
      "id": "a2_day2_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_dragon_flight.png"
      },
      "effects": [
        "wind"
      ],
      "music": "dragon_flight",
      "characters": [],
      "lines": [
        {
          "text": "Druhý den ráno se jezdkyně vznesly nad les a zamířily k hradišti. Do slunovratu zbývaly dva dny."
        }
      ],
      "next": "a2_vedma_01"
    },
    {
      "id": "a2_vedma_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/vedma_hut.png"
      },
      "effects": [],
      "music": "vedma_hut",
      "characters": [
        {
          "id": "vedma",
          "position": "left",
          "pose": "neutral"
        }
      ],
      "lines": [
        {
          "text": "Vědma bydlela v chýši kousek za valem hradiště. Ze střechy visely svazky sušených bylin a z komína stoupal dým."
        },
        {
          "speaker": "vedma",
          "text": "Jezdkyně? Co vás ke mně přivádí tak brzy ráno?"
        },
        {
          "speaker": "emma",
          "text": "Hledáme zrzavou ženu v šarlatových šatech. Soňa říkala, že u vás byla.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "text": "Vědma zbledla a dlouho mlčela."
        },
        {
          "speaker": "vedma",
          "text": "Jmenuje se Rubínka. Bývala dračí jezdkyně, jako vy. Jejím drakem byl Tesák, rudý jako oheň.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "sad"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "vedma",
          "text": "Loni Tesák onemocněl popelavkou. Drak přichází o oheň, šupiny mu šednou jako popel, až nakonec úplně vyhasne.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "talking"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "anna",
          "text": "O popelavce jsem slyšela. Prý přechází z draka na draka.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "talking"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "nervous"
            }
          ]
        },
        {
          "speaker": "vedma",
          "text": "Právě proto. Rubínka sem s Tesákem přiletěla prosit o pomoc. Ale lidé z hradiště se báli o své draky a zavřeli bránu.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "sad"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "nervous"
            }
          ]
        },
        {
          "speaker": "vedma",
          "text": "A já jsem za nimi mohla vyjít. Jenže jsem se neodvážila jít proti všem. Tesák tu noc umřel."
        },
        {
          "text": "Jezdkyně se na sebe podívaly."
        }
      ],
      "choices": [
        {
          "text": "„Jak jste jí mohla nepomoct?!“",
          "next": "a2_vedma_angry_01"
        },
        {
          "text": "„Bála jste se. To se může stát každému.“",
          "next": "a2_vedma_kind_01"
        }
      ]
    },
    {
      "id": "a2_vedma_angry_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/vedma_hut.png"
      },
      "effects": [],
      "music": "vedma_hut",
      "characters": [
        {
          "id": "vedma",
          "position": "left",
          "pose": "sad"
        },
        {
          "id": "anna",
          "position": "right",
          "pose": "nervous"
        }
      ],
      "lines": [
        {
          "speaker": "anna",
          "text": "Jak jste jí mohla nepomoct?! Vždyť Tesák umřel!"
        },
        {
          "speaker": "vedma",
          "text": "Máš pravdu. Nemám se čím omlouvat."
        },
        {
          "text": "Vědma se odvrátila a chvíli jen mlčky míchala byliny v hrnci."
        }
      ],
      "next": "a2_vedma_water_01"
    },
    {
      "id": "a2_vedma_kind_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/vedma_hut.png"
      },
      "effects": [],
      "music": "vedma_hut",
      "characters": [
        {
          "id": "vedma",
          "position": "left",
          "pose": "sad"
        },
        {
          "id": "emma",
          "position": "right",
          "pose": "talking"
        }
      ],
      "lines": [
        {
          "speaker": "emma",
          "text": "Bála jste se. To se může stát každému."
        },
        {
          "speaker": "vedma",
          "text": "Děkuju, děvče. Celý rok mě to tíží. Kdybyste někdy potřebovaly mou pomoc, přijďte. Pomůžu vám, jak jen budu umět.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "happy"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "talking"
            }
          ]
        }
      ],
      "next": "a2_vedma_water_01"
    },
    {
      "id": "a2_vedma_water_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/vedma_hut.png"
      },
      "effects": [],
      "music": "vedma_hut",
      "characters": [
        {
          "id": "vedma",
          "position": "left",
          "pose": "happy"
        },
        {
          "id": "roza",
          "position": "right",
          "pose": "talking"
        }
      ],
      "lines": [
        {
          "speaker": "roza",
          "text": "A proč za vámi Rubínka přišla teď?"
        },
        {
          "speaker": "vedma",
          "text": "Ptala se, kde najde mrtvou vodu. Takovou, co hojí rány, ale nikoho neoživí.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "talking"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "vedma",
          "text": "Mrtvá voda vyvěrá jen tam, kde se náš svět dotýká Navi, říše mrtvých. Bojím se, co to znamená.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "sad"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "emma",
          "text": "Velká voda za přehradou… nejkratší noc… a mrtvá voda. Myslíte, že chce otevřít bránu do Navi?",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "sad"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "nervous"
            }
          ]
        },
        {
          "speaker": "vedma",
          "text": "Aby získala Tesáka zpátky. Toho se bojím. Víc o Navi ví jen Triglav v posvátném háji. Jeho tři hlavy vidí do nebe, na zem i pod zem."
        },
        {
          "speaker": "anna",
          "text": "Tak poletíme do posvátného háje.",
          "characters": [
            {
              "id": "vedma",
              "position": "left",
              "pose": "sad"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "talking"
            }
          ]
        }
      ],
      "next": "a2_hejkal_01"
    },
    {
      "id": "a2_hejkal_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_path.png"
      },
      "effects": [],
      "music": "forest_ground",
      "characters": [],
      "lines": [
        {
          "text": "Cesta do posvátného háje vedla hlubokým lesem. Jezdkyně zrovna přistály u potoka, aby se draci napili, když se z houští ozvalo: „Hej! Hej!“"
        },
        {
          "speaker": "anna",
          "text": "Slyšely jste to? Někdo na nás volá.",
          "characters": [
            {
              "id": "anna",
              "position": "right",
              "pose": "nervous"
            }
          ]
        },
        {
          "speaker": "emma",
          "text": "To bude hejkal. Prý mate poutníky, dokud nezabloudí.",
          "characters": [
            {
              "id": "emma",
              "position": "right",
              "pose": "nervous"
            }
          ]
        }
      ],
      "next": "a2_hejkal_04"
    },
    {
      "id": "a2_hejkal_04",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_path.png"
      },
      "effects": [],
      "music": "playful",
      "characters": [
        {
          "id": "hejkal",
          "position": "left",
          "pose": "neutral"
        },
        {
          "id": "emma",
          "position": "right",
          "pose": "nervous"
        }
      ],
      "lines": [
        {
          "speaker": "hejkal",
          "text": "Hej! Hej, jezdkyně! Kam tak spěcháte?"
        },
        {
          "speaker": "roza",
          "text": "Do posvátného háje. A ty nás nezmateš!",
          "characters": [
            {
              "id": "hejkal",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "hejkal",
          "text": "Zmást? Já? Kdepak. Mně je tady jen hrozně dlouhá chvíle. Sto let sedím na pařezu a nikdo si se mnou nepovídá."
        },
        {
          "speaker": "anna",
          "text": "To musí být smutné. Chceš slyšet hádanku?",
          "characters": [
            {
              "id": "hejkal",
              "position": "left",
              "pose": "happy"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "happy"
            }
          ]
        },
        {
          "text": "Hejkal se rozzářil. Hádal a hádal, a když konečně uhodl, zahejkal radostí tak, že ze tří smrků popadaly šišky."
        },
        {
          "speaker": "hejkal",
          "text": "Děkuju, děvčata! Do háje je to rovně za sluncem. A kdyby vás někdo zlobil, zahejkám na něj!"
        }
      ],
      "next": "a2_fawn_01"
    },
    {
      "id": "a2_fawn_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_clearing.png"
      },
      "effects": [],
      "music": "forest_ground",
      "characters": [
        {
          "id": "srnce",
          "position": "left",
          "pose": "neutral"
        },
        {
          "id": "anna",
          "position": "right",
          "pose": "happy"
        }
      ],
      "lines": [
        {
          "text": "Na mýtině stálo malé srnče s bílými tečkami na hřbetě a třáslo se strachy."
        },
        {
          "speaker": "emma",
          "text": "Ztratilo maminku. Samo ji nenajde, les je moc velký.",
          "characters": [
            {
              "id": "srnce",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "roza",
          "text": "Z dračích hřbetů bychom ji našly rychle. Ale zase přijdeme o čas.",
          "characters": [
            {
              "id": "srnce",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "anna",
          "text": "Co uděláme?",
          "characters": [
            {
              "id": "srnce",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "talking"
            }
          ]
        }
      ],
      "choices": [
        {
          "text": "Najdeme srnčeti maminku.",
          "next": "a2_fawn_help_01"
        },
        {
          "text": "Nemůžeme se zdržovat.",
          "next": "a2_fawn_skip_01"
        }
      ]
    },
    {
      "id": "a2_fawn_help_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_clearing.png"
      },
      "effects": [],
      "music": "forest_ground",
      "characters": [
        {
          "id": "anna",
          "position": "right",
          "pose": "talking"
        }
      ],
      "lines": [
        {
          "text": "Jezdkyně kroužily nad lesem, dokud Emma nezahlédla srnu, jak úzkostlivě pobíhá po kraji paseky."
        },
        {
          "text": "Srnče k ní radostně přiskákalo a srna ho olízala od uší až po ocásek.",
          "characters": [
            {
              "id": "srna",
              "position": "left",
              "pose": "happy"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "talking"
            }
          ]
        },
        {
          "speaker": "srna",
          "text": "Děkuju vám. Vím, kam letíte. Znám stezku přes bažiny, kterou neznají ani lidé. Ušetří vám půl dne cesty."
        },
        {
          "speaker": "emma",
          "text": "Takže jsme čas vlastně ani neztratily!",
          "characters": [
            {
              "id": "srna",
              "position": "left",
              "pose": "happy"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "happy"
            }
          ]
        }
      ],
      "next": "a2_day3_01"
    },
    {
      "id": "a2_fawn_skip_01",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/forest_clearing.png"
      },
      "effects": [],
      "music": "forest_ground",
      "characters": [
        {
          "id": "srnce",
          "position": "left",
          "pose": "neutral"
        },
        {
          "id": "emma",
          "position": "right",
          "pose": "happy"
        }
      ],
      "lines": [
        {
          "text": "Jezdkyně nechaly srnče na mýtině a ještě dlouho se za ním ohlížely."
        },
        {
          "speaker": "anna",
          "text": "Snad ho maminka brzy najde.",
          "characters": [
            {
              "id": "srnce",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "sad"
            }
          ]
        }
      ],
      "next": "a2_day3_01"
    }
  ]
}
