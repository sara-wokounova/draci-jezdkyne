    },
    {
      "id": "hory_zubr_prohra",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/mountain_meadow.png"
      },
      "characters": [
        {
          "id": "zubr",
          "position": "left",
          "pose": "neutral"
        }
      ],
      "choiceLayout": "center",
      "lines": [],
      "choices": [
        {
          "text": "Zkusit to znovu.",
          "next": "hory_zubr_zpev"
        },
        {
          "text": "Odletět a vrátit se později.",
          "next": "a2_cesta",
          "giveUp": true,
          "set": [
            "zubr_prohra"
          ]
        }
      ]
    },
    {
      "id": "hory_zubr_pomoc",
      "background": {
        "type": "image",
        "src": "assets/backgrounds/mountain_meadow.png"
      },
      "music": "forest_ground",
      "characters": [
        {
          "id": "zubr",
          "position": "left",
          "pose": "happy"
        }
      ],
      "set": [
        "zubr",
        "melodie"
      ],
      "next": "a2_cesta",
      "lines": [
        {
          "text": "Poslední tón odplul nad louku a ztichl. Zubr stál a dýchal ztěžka, jako by nesl na hřbetě celý les.",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "neutral"
            }
          ]
        },
        {
          "text": "Pět hvězd jedna po druhé pohaslo a obloha nad loukou zase zesvětlala. Jen v trávě jako by ještě chvilku zněla ozvěna písně."
        },
        {
          "speaker": "emma",
          "text": "Pst… Ani se nehněte. Podívejte, jak se mu chvějí boky. On poslouchal.",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "emma",
              "position": "right",
              "pose": "nervous"
            }
          ]
        },
        {
          "speaker": "anna",
          "text": "Tak vidíš. Potichu to šlo, a křikem ne. Někdy se vyplatí mě poslechnout.",
          "if": "!haj_zeme",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "happy"
            }
          ]
        },
        {
          "speaker": "anna",
          "text": "Triglav měl pravdu. Omámení zlomil klidný hlas, ne křik.",
          "if": "haj_zeme",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "anna",
              "position": "right",
              "pose": "happy"
            }
          ]
        },
        {
          "text": "Zubr přestal funět. Uši se mu pohnuly, nejdřív jedno, pak druhé, jako by teprve teď zaslechl bučení z údolí.",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "neutral"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "neutral"
            }
          ]
        },
        {
          "text": "Mlha v jeho očích zřídla, roztrhala se jako pára nad hrncem – a pak zamrkal.",
          "characters": [
            {
              "id": "zubr",
              "position": "left",
              "pose": "happy"
            },
            {
              "id": "roza",
              "position": "right",
              "pose": "happy"
            }
          ]
        },
        {
          "speaker": "zubr",
          "text": "Kde to… Stál jsem na louce. Přišla zrzavá žena a zpívala. Krásně zpívala. A pak už nic, jen ten zpěv, pořád dokola, a nešlo z něj ven."
        },
        {
          "speaker": "zubr",
          "text": "Tvoje píseň byla tišší než její, a přece jí vzala moc. Zavolala jsi mě a já se vrátil k sobě. Až budete potřebovat něco prorazit, vyvrátit nebo rozdupat, zubří stádo přijde."
        },
        {
          "speaker": "roza",
          "text": "Tichá píseň zmůže víc než všechen křik světa. To si zapamatuju. I tu melodii, tón po tónu."
        }
      ]
    }
  ]
}
